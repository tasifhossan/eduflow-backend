# Environment variables declared in this file are automatically made available to Prisma.
# See the documentation for more detail: https://pris.ly/d/prisma-schema#accessing-environment-variables-from-the-schema

# Prisma supports the native connection string format for PostgreSQL, MySQL, SQLite, SQL Server, MongoDB and CockroachDB.
# See the documentation for all the connection string options: https://pris.ly/d/connection-strings

# Pooled connection string (used by application to read/write)
DATABASE_URL="postgresql://user:password@host:port/dbname?pgbouncer=true"

# Direct connection string (used by Prisma migrate to execute DDL migrations)
DIRECT_URL="postgresql://user:password@host:port/dbname"

# JWT secret key for signing/verifying authentication tokens
JWT_SECRET="your-jwt-secret-key"

# Frontend application URL (CORS allowed origin)
FRONTEND_URL="https://your-frontend-vercel-url.vercel.app"

# Application server port
PORT=5000

