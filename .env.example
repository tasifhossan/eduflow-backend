# Environment variables declared in this file are automatically made available to Prisma.
# See the documentation for more detail: https://pris.ly/d/prisma-schema#accessing-environment-variables-from-the-schema

# Prisma supports the native connection string format for PostgreSQL, MySQL, SQLite, SQL Server, MongoDB and CockroachDB.
# See the documentation for all the connection string options: https://pris.ly/d/connection-strings

# Pooled connection string (used by application to read/write)
DATABASE_URL="postgresql://user:password@host:port/dbname?pgbouncer=true"

# Direct connection string (used by Prisma migrate to execute DDL migrations)
DIRECT_URL="postgresql://user:password@host:port/dbname"

# JWT secret key for signing/verifying authentication tokens
JWT_SECRET="your-jwt-secret-key"

# Frontend application URL (CORS allowed origin)
FRONTEND_URL="https://your-frontend-vercel-url.vercel.app"

# Application server port
PORT=5000

# Set to "production" on Render — controls cookie secure/sameSite flags for cross-domain auth
NODE_ENV=development

# Cloudinary configuration (from Cloudinary dashboard: https://console.cloudinary.com/)
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"

# Email configuration
# Option A — Brevo HTTP API (recommended for production, no SMTP auth issues)
# Get your API key from: Brevo → Settings → SMTP & API → API Keys
# BREVO_SENDER_EMAIL must be a verified sender in Brevo (Settings → Senders)
BREVO_API_KEY="xkeysib-your-brevo-api-key"
BREVO_SENDER_EMAIL="ttasif293@gmail.com"

# Option B — SMTP fallback (used when BREVO_API_KEY is not set; good for local dev with Mailtrap)
# Mailtrap sandbox: SMTP_HOST=sandbox.smtp.mailtrap.io, SMTP_PORT=2525
SMTP_HOST="sandbox.smtp.mailtrap.io"
SMTP_PORT=2525
SMTP_USER="your-mailtrap-username"
SMTP_PASS="your-mailtrap-password"
SMTP_FROM="EduFlow <noreply@eduflow.app>"
