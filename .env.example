# Database Connection Settings
# Pooled connection string used by the application (must include pgbouncer=true and a small connection_limit, e.g. ?pgbouncer=true&connection_limit=5)
DATABASE_URL=""
# Direct database connection string without pooling, required by Prisma migrate for DDL migrations
DIRECT_URL=""

# Authentication & Security
# Secret key for JWT signing and verification (minimum 32 characters, generate with a secure random generator)
JWT_SECRET=""
# Allowed frontend application URL for CORS configuration and credentialed cookies
FRONTEND_URL=""

# Google OAuth Configuration
# Google OAuth 2.0 Client ID for Google authentication
GOOGLE_CLIENT_ID=""
# Default branch ID assigned to users registering via Google OAuth
GOOGLE_DEFAULT_BRANCH_ID=""

# LLM / AI Integration
# API key for the LLM service provider
LLM_API_KEY=""
# Model identifier for the LLM provider (e.g. claude-3-7-sonnet-20250219 or claude-3-5-haiku-20241022)
LLM_MODEL=""

# Demo Mode & Seeding
# Enables demo mode behavior when set to true (true/false)
DEMO_MODE=""
# Notice explaining demo seed behavior: sample demo users are assigned randomly generated passwords instead of static defaults
SEED_DEMO_PASSWORD_NOTE=""

# Server Environment
# Application HTTP server listening port
PORT=5000
# Node environment mode (development/production/test)
NODE_ENV=development

# Cloudinary Media Storage
# Cloudinary cloud name for media assets
CLOUDINARY_CLOUD_NAME=""
# Cloudinary API key
CLOUDINARY_API_KEY=""
# Cloudinary API secret
CLOUDINARY_API_SECRET=""

# Email Notifications (Brevo HTTP API)
# Brevo API key for transactional emails
BREVO_API_KEY=""
# Verified sender email address registered in Brevo
BREVO_SENDER_EMAIL=""

# Fallback SMTP Configuration (Local Development / Mailtrap)
# SMTP server hostname
SMTP_HOST=""
# SMTP server port (e.g. 2525 or 587)
SMTP_PORT=2525
# SMTP username
SMTP_USER=""
# SMTP password
SMTP_PASS=""
# Outgoing sender display name and email address
SMTP_FROM=""
