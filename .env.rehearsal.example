# Production Rehearsal Configuration Example
# Copy to .env.rehearsal and fill in your scratch database credentials.
# NOTE: The database name in DATABASE_URL/DIRECT_URL MUST contain "scratch" or "rehearsal"

NODE_ENV=
PORT=
DATABASE_URL=
DIRECT_URL=
JWT_SECRET=
FRONTEND_URL=

DEMO_MODE=
ALLOW_DEMO_SEED=

# Rehearsal Center Bootstrap & Owner Credentials
CENTER_NAME=
CENTER_EMAIL=
CENTER_PHONE=
OWNER_NAME=
OWNER_EMAIL=
OWNER_PASSWORD=

# Media Storage (Optional)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Email Notifications (Optional)
BREVO_API_KEY=
BREVO_SENDER_EMAIL=

# AI Integration (Optional)
GEMINI_API_KEY=
LLM_MODEL=
LLM_DAILY_LIMIT=

