// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  ADMIN
  TEACHER
  STUDENT
  GUARDIAN
  SUPER_ADMIN
  ACCOUNTANT
}

enum FeeBilling {
  MONTHLY
  ONE_TIME
  NONE
}

enum FeeChargeKind {
  TUITION
  ADMISSION
  EXAM
  MATERIAL
  OTHER
}

enum FeeChargeSource {
  GENERATED
  MANUAL
  INSTALLMENT
  MIGRATED
}

enum FeeChargeStatus {
  ACTIVE
  VOID
}

enum FeeAdjustmentType {
  DISCOUNT
  WAIVER
  CORRECTION
}

enum FeeAdjustmentStatus {
  ACTIVE
  VOID
}

enum PaymentMethod {
  CASH
  BKASH
  NAGAD
  ROCKET
  BANK
  CARD
  OTHER
}

enum PaymentSource {
  MANUAL
  MIGRATED
}

enum BatchType {
  ACADEMIC
  ADMISSION
}

enum EnrollmentStatus {
  ACTIVE
  INACTIVE
}

enum DayOfWeek {
  SUNDAY
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
}

enum FeeType {
  MONTHLY
  ONE_TIME
}

enum DiscountType {
  FIXED
  PERCENTAGE
}

enum PaymentStatus {
  DUE
  PARTIAL
  PAID
}

enum TestType {
  MCQ
  WRITTEN
  MIXED
  OFFLINE
}

enum QuestionType {
  MCQ
  WRITTEN
}

enum ContactMessageStatus {
  NEW
  READ
  REPLIED
  ARCHIVED
}

enum LectureStatus {
  PLANNED
  COMPLETED
  CANCELLED
}

enum OnlineProvider {
  MEET
  ZOOM
  OTHER
}

enum AssignmentMode {
  ONLINE
  OFFLINE
}

enum AssignmentSubmissionStatus {
  SUBMITTED
  GRADED
}

enum AttachmentKind {
  FILE
  LINK
}


model Branch {
  id        String   @id @default(cuid())
  name      String
  code      String?  @unique
  address   String?
  createdAt DateTime @default(now())
  users     User[]
  batches   Batch[]
  notices   Notice[]
  attachments Attachment[]
  feeCharges FeeCharge[]
  feeAdjustments FeeAdjustment[]
  payments Payment[]
  paymentAllocations PaymentAllocation[]
  paymentReversals PaymentReversal[]
  receiptSequences ReceiptSequence[]
}

model User {
  id                   String                  @id @default(cuid())
  name                 String
  email                String?                 @unique
  studentCode          String?                 @unique
  phone                String?                 @unique
  guardianName         String?
  guardianPhone        String?
  password             String
  role                 Role
  branchId             String
  branch               Branch                  @relation(fields: [branchId], references: [id])
  avatarUrl            String?
  bio                  String?
  headline             String?
  isPublicProfile      Boolean                 @default(false)
  mustChangePassword   Boolean                 @default(false)
  isActive             Boolean                 @default(true)
  lastLoginAt          DateTime?
  passwordChangedAt    DateTime?
  deactivatedAt        DateTime?
  createdAt            DateTime                @default(now())
  teachingBatches      Batch[]                 @relation(name: "TeachingBatches")
  enrollments          Enrollment[]
  attendances          Attendance[]            @relation(name: "StudentAttendances")
  markedAttendances    Attendance[]            @relation(name: "MarkedAttendances")
  createdTests         Test[]                  @relation(name: "CreatedTests")
  studentAnswers       StudentAnswer[]
  results              Result[]
  feePayments          FeePayment[]            @relation(name: "FeePayments")
  recordedPayments     FeePayment[]            @relation(name: "RecordedPayments")
  guardianChangeLogs   GuardianInfoChangeLog[] @relation(name: "GuardianChangeLogs")
  adminGuardianChanges GuardianInfoChangeLog[] @relation(name: "AdminGuardianChanges")
  guardianLinks        GuardianLink[]          @relation(name: "GuardianStudents")
  studentGuardians     GuardianLink[]          @relation(name: "StudentGuardians")
  createdNotices       Notice[]                @relation(name: "CreatedNotices")
  uploadedResources    Resource[]              @relation(name: "UploadedResources")
  practiceSessions     PracticeSession[]
  reviews              Review[]
  passwordResetTokens  PasswordResetToken[]
  notifyByEmail        Boolean                 @default(true)
  teacherLectures      Lecture[]               @relation(name: "TeacherLectures")
  createdLectures      Lecture[]               @relation(name: "CreatedLectures")
  createdAssignments   Assignment[]            @relation(name: "CreatedAssignments")
  assignmentSubmissions AssignmentSubmission[] @relation(name: "StudentAssignmentSubmissions")
  gradedSubmissions    AssignmentSubmission[]  @relation(name: "GradedSubmissions")
  uploadedAttachments  Attachment[]            @relation(name: "UploadedAttachments")
  notifications        Notification[]          @relation(name: "UserNotifications")
  feeChargesCreated    FeeCharge[]             @relation(name: "FeeChargesCreated")
  feeChargesVoided     FeeCharge[]             @relation(name: "FeeChargesVoided")
  studentFeeCharges    FeeCharge[]             @relation(name: "StudentFeeCharges")
  feeAdjustmentsCreated FeeAdjustment[]        @relation(name: "FeeAdjustmentsCreated")
  feeAdjustmentsVoided FeeAdjustment[]         @relation(name: "FeeAdjustmentsVoided")
  studentPayments      Payment[]               @relation(name: "StudentPayments")
  receivedPayments     Payment[]               @relation(name: "ReceivedPayments")
  paymentReversals     PaymentReversal[]       @relation(name: "PaymentReversals")


  @@index([branchId])
  @@index([role])
  @@index([studentCode])
  @@index([phone])
  @@index([isActive])
}

model PasswordResetToken {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash   String    @unique
  expiresAt   DateTime
  usedAt      DateTime?
  createdAt   DateTime  @default(now())
  createdById String?

  @@index([userId])
  @@index([tokenHash])
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  action     String
  entityType String
  entityId   String?
  branchId   String?
  metadata   Json?
  ip         String?
  createdAt  DateTime @default(now())

  @@index([action])
  @@index([entityType])
  @@index([actorId])
  @@index([branchId])
  @@index([createdAt])
}

model GuardianInfoChangeLog {
  id          String   @id @default(cuid())
  studentId   String
  student     User     @relation(name: "GuardianChangeLogs", fields: [studentId], references: [id])
  field       String
  oldValue    String?
  newValue    String?
  changedById String
  changedBy   User     @relation(name: "AdminGuardianChanges", fields: [changedById], references: [id])
  changedAt   DateTime @default(now())

  @@index([studentId])
  @@index([changedById])
}

model Subject {
  id       String    @id @default(cuid())
  name     String
  chapters    Chapter[]
  batches     Batch[]
  lectures    Lecture[]
  assignments Assignment[]
}

model Chapter {
  id        String     @id @default(cuid())
  name      String
  subjectId String
  subject   Subject    @relation(fields: [subjectId], references: [id])
  tests     Test[]
  resources Resource[]
  lectures  Lecture[]

  @@index([subjectId])
}

model Batch {
  id               String            @id @default(cuid())
  slug             String?           @unique
  name             String
  type             BatchType
  classLevel       String?
  feeType          FeeType           @default(MONTHLY)
  feeBilling       FeeBilling        @default(MONTHLY)
  feeAmount        Decimal           @default(0) @db.Decimal(12, 2)
  description      String?
  imageUrl         String?
  gallery          String[]          @default([])
  syllabus         Json?
  highlights       String[]          @default([])
  isPublished      Boolean           @default(true)
  subjectId        String
  subject          Subject           @relation(fields: [subjectId], references: [id])
  branchId         String
  branch           Branch            @relation(fields: [branchId], references: [id])
  createdAt        DateTime          @default(now())
  teacherId        String?
  teacher          User?             @relation(name: "TeachingBatches", fields: [teacherId], references: [id])
  enrollments      Enrollment[]
  routineSlots     RoutineSlot[]
  attendances      Attendance[]
  tests            Test[]
  feePayments      FeePayment[]
  feeCharges       FeeCharge[]
  notices          Notice[]
  resources        Resource[]
  practiceSessions PracticeSession[]
  reviews          Review[]
  contactMessages  ContactMessage[]
  lectures         Lecture[]
  assignments      Assignment[]


  @@index([branchId])
  @@index([subjectId])
  @@index([teacherId])
  @@index([isPublished])
}

model Enrollment {
  id              String           @id @default(cuid())
  studentId       String
  student         User             @relation(fields: [studentId], references: [id])
  batchId         String
  batch           Batch            @relation(fields: [batchId], references: [id])
  enrolledAt      DateTime         @default(now())
  status          EnrollmentStatus @default(ACTIVE)
  customFeeAmount Decimal?         @db.Decimal(12, 2)
  discountType    DiscountType?
  discountValue   Decimal?         @db.Decimal(12, 2)
  discountReason  String?
  feeCharges      FeeCharge[]

  @@unique([studentId, batchId])
  @@index([batchId])
  @@index([studentId])
  @@index([status])
}

model RoutineSlot {
  id        String    @id @default(cuid())
  batchId   String
  batch     Batch     @relation(fields: [batchId], references: [id])
  dayOfWeek DayOfWeek
  startTime String
  endTime   String
  lectures  Lecture[]

  @@index([batchId])
}

model Attendance {
  id         String           @id @default(cuid())
  studentId  String
  student    User             @relation(name: "StudentAttendances", fields: [studentId], references: [id])
  batchId    String
  batch      Batch            @relation(fields: [batchId], references: [id])
  date       DateTime
  status     AttendanceStatus
  markedById String
  markedBy   User             @relation(name: "MarkedAttendances", fields: [markedById], references: [id])

  @@unique([studentId, batchId, date])
  @@index([batchId])
  @@index([studentId])
  @@index([date])
}

model Test {
  id                   String     @id @default(cuid())
  title                String
  type                 TestType
  batchId              String
  batch                Batch      @relation(fields: [batchId], references: [id])
  chapterId            String?
  chapter              Chapter?   @relation(fields: [chapterId], references: [id])
  totalMarks           Float
  negativeMarkingValue Float      @default(0)
  durationMinutes      Int?
  testDate             DateTime
  createdById          String
  createdBy            User       @relation(name: "CreatedTests", fields: [createdById], references: [id])
  createdAt            DateTime   @default(now())
  questions            Question[]
  results              Result[]

  @@index([batchId])
  @@index([chapterId])
  @@index([createdById])
}

model Question {
  id             String          @id @default(cuid())
  testId         String
  test           Test            @relation(fields: [testId], references: [id], onDelete: Cascade)
  type           QuestionType
  text           String
  marks          Float
  order          Int
  options        Option[]
  studentAnswers StudentAnswer[]

  @@index([testId])
}

model Option {
  id             String          @id @default(cuid())
  questionId     String
  question       Question        @relation(fields: [questionId], references: [id], onDelete: Cascade)
  text           String
  isCorrect      Boolean         @default(false)
  studentAnswers StudentAnswer[]

  @@index([questionId])
}

model StudentAnswer {
  id                String   @id @default(cuid())
  studentId         String
  student           User     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  questionId        String
  question          Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  selectedOptionId  String?
  selectedOption    Option?  @relation(fields: [selectedOptionId], references: [id])
  writtenAnswerText String?
  marksAwarded      Float?

  @@unique([studentId, questionId])
  @@index([studentId])
  @@index([questionId])
}

model Result {
  id                 String   @id @default(cuid())
  studentId          String
  student            User     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  testId             String
  test               Test     @relation(fields: [testId], references: [id], onDelete: Cascade)
  totalMarksObtained Float
  rank               Int?
  submittedAt        DateTime

  @@unique([studentId, testId])
  @@index([studentId])
  @@index([testId])
}

model FeePayment {
  id           String        @id @default(cuid())
  studentId    String
  student      User          @relation(name: "FeePayments", fields: [studentId], references: [id])
  batchId      String
  batch        Batch         @relation(fields: [batchId], references: [id])
  period       String
  amountDue    Float
  amountPaid   Float         @default(0)
  status       PaymentStatus @default(DUE)
  dueDate      DateTime?
  paidAt       DateTime?
  recordedById String
  recordedBy   User          @relation(name: "RecordedPayments", fields: [recordedById], references: [id])
  notes        String?
  createdAt    DateTime      @default(now())

  @@unique([studentId, batchId, period])
  @@index([studentId])
  @@index([batchId])
  @@index([recordedById])
  @@index([status])
}

model GuardianLink {
  id         String   @id @default(cuid())
  guardianId String
  guardian   User     @relation(name: "GuardianStudents", fields: [guardianId], references: [id])
  studentId  String
  student    User     @relation(name: "StudentGuardians", fields: [studentId], references: [id])
  createdAt  DateTime @default(now())

  @@unique([guardianId, studentId])
  @@index([guardianId])
  @@index([studentId])
}

model Notice {
  id          String   @id @default(cuid())
  title       String
  content     String
  branchId    String
  branch      Branch   @relation(fields: [branchId], references: [id])
  batchId     String?
  batch       Batch?   @relation(fields: [batchId], references: [id])
  createdById String
  createdBy   User     @relation(name: "CreatedNotices", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())

  @@index([branchId])
  @@index([batchId])
  @@index([createdById])
}

model Resource {
  id           String   @id @default(cuid())
  title        String
  fileUrl      String
  fileType     String
  batchId      String
  batch        Batch    @relation(fields: [batchId], references: [id])
  chapterId    String?
  chapter      Chapter? @relation(fields: [chapterId], references: [id])
  uploadedById String
  uploadedBy   User     @relation(name: "UploadedResources", fields: [uploadedById], references: [id])
  createdAt    DateTime @default(now())

  @@index([batchId])
  @@index([chapterId])
  @@index([uploadedById])
}

model PracticeSession {
  id             String    @id @default(cuid())
  studentId      String
  student        User      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  batchId        String
  batch          Batch     @relation(fields: [batchId], references: [id], onDelete: Cascade)
  chapterIds     String[]
  questionIds    String[]
  answers        Json?     // null until submitted; then [{ questionId, selectedOptionId, correct }]
  totalQuestions Int
  correctAnswers Int?      // null until submitted
  score          Float?    // null until submitted
  createdAt      DateTime  @default(now())
  submittedAt    DateTime?

  @@index([studentId, batchId])
  @@index([batchId])
}

model Review {
  id        String   @id @default(cuid())
  batchId   String
  batch     Batch    @relation(fields: [batchId], references: [id], onDelete: Cascade)
  studentId String
  student   User     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  rating    Int
  comment   String?
  createdAt DateTime @default(now())

  @@unique([batchId, studentId])
  @@index([batchId])
  @@index([studentId])
}

model BlogPost {
  id          String    @id @default(cuid())
  slug        String    @unique
  title       String
  excerpt     String?
  content     String
  coverImage  String?
  category    String
  authorName  String
  isPublished Boolean   @default(false)
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([isPublished, publishedAt])
  @@index([category])
}

model Testimonial {
  id         String   @id @default(cuid())
  name       String
  roleTitle  String
  content    String
  avatarUrl  String?
  rating     Int      @default(5)
  isFeatured Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([isFeatured])
}

model ContactMessage {
  id                String               @id @default(cuid())
  name              String
  email             String?
  phone             String?
  subject           String?
  message           String?
  interestedBatchId String?
  interestedBatch   Batch?               @relation(fields: [interestedBatchId], references: [id], onDelete: SetNull)
  interestedGrade   String?
  source            String               @default("WEBSITE")
  status            ContactMessageStatus @default(NEW)
  createdAt         DateTime             @default(now())

  @@index([status])
  @@index([createdAt])
  @@index([interestedBatchId])
}

model NewsletterSubscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now())
}

model FaqItem {
  id        String   @id @default(cuid())
  question  String
  answer    String
  category  String
  sortOrder Int      @default(0)

  @@index([category, sortOrder])
}

model CenterSettings {
  id                     String   @id @default(cuid())
  key                    String   @unique @default("center")
  name                   String   @default("Coaching Center")
  shortName              String   @default("Center")
  tagline                String   @default("")
  logoUrl                String?
  faviconUrl             String?
  primaryColor           String   @default("#4f46e5")
  contactEmail           String   @default("")
  contactPhone           String   @default("")
  whatsapp               String?
  address                String   @default("")
  socials                Json?
  currency               String   @default("BDT")
  currencySymbol         String   @default("৳")
  timezone               String   @default("Asia/Dhaka")
  defaultLocale          String   @default("en")
  academicYearStartMonth Int      @default(1)
  weekStartsOn           Int      @default(6)
  feeDueDay              Int      @default(10)
  receiptHeader          String?
  receiptFooter          String?
  features               Json     @default("{\"publicSite\":true,\"aiAssistant\":true,\"blog\":true,\"reviews\":true,\"testimonials\":true,\"newsletter\":false,\"showPoweredBy\":true,\"lectures\":true,\"assignments\":true,\"onlineClasses\":true}")
  homepage               Json     @default("{\"heroBadge\":\"\",\"heroPoints\":[],\"heroTitle\":\"\",\"heroSubtitle\":\"\",\"heroImageUrl\":null,\"announcement\":{\"enabled\":false,\"text\":\"\",\"linkLabel\":\"\",\"linkUrl\":\"\"},\"highlights\":[],\"whyChooseUs\":[],\"admissionSteps\":[],\"showFees\":true,\"showPhotoGallery\":true}")
  officeHours            String?
  about                  Json?
  legal                  Json?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
}

model Lecture {
  id             String          @id @default(cuid())
  batchId        String
  batch          Batch           @relation(fields: [batchId], references: [id], onDelete: Cascade)
  subjectId      String
  subject        Subject         @relation(fields: [subjectId], references: [id])
  chapterId      String?
  chapter        Chapter?        @relation(fields: [chapterId], references: [id])
  teacherId      String
  teacher        User            @relation(name: "TeacherLectures", fields: [teacherId], references: [id])
  routineSlotId  String?
  routineSlot    RoutineSlot?    @relation(fields: [routineSlotId], references: [id], onDelete: SetNull)
  title          String?
  plannedTopics  String
  coveredTopics  String?
  homeworkNote   String?
  startsAt       DateTime
  endsAt         DateTime
  status         LectureStatus   @default(PLANNED)
  cancelReason   String?
  rescheduledAt  DateTime?
  isPublished    Boolean         @default(false)
  onlineProvider OnlineProvider?
  onlineUrl      String?
  onlinePasscode String?
  createdById    String
  createdBy      User            @relation(name: "CreatedLectures", fields: [createdById], references: [id])
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  attachments    Attachment[]
  assignments    Assignment[]

  @@unique([routineSlotId, startsAt])
  @@index([batchId, startsAt])
  @@index([teacherId, startsAt])
  @@index([status])
}

model Assignment {
  id           String                 @id @default(cuid())
  batchId      String
  batch        Batch                  @relation(fields: [batchId], references: [id], onDelete: Cascade)
  subjectId    String?
  subject      Subject?               @relation(fields: [subjectId], references: [id])
  lectureId    String?
  lecture      Lecture?               @relation(fields: [lectureId], references: [id], onDelete: SetNull)
  title        String
  instructions String
  dueAt        DateTime
  maxMarks     Decimal                @db.Decimal(6, 2)
  mode         AssignmentMode
  allowLate    Boolean                @default(false)
  publishedAt  DateTime?
  createdById  String
  createdBy    User                   @relation(name: "CreatedAssignments", fields: [createdById], references: [id])
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt
  submissions  AssignmentSubmission[]
  attachments  Attachment[]

  @@index([batchId, dueAt])
  @@index([publishedAt])
}

model AssignmentSubmission {
  id           String                     @id @default(cuid())
  assignmentId String
  assignment   Assignment                 @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  studentId    String
  student      User                       @relation(name: "StudentAssignmentSubmissions", fields: [studentId], references: [id], onDelete: Cascade)
  textAnswer   String?
  submittedAt  DateTime?
  isLate       Boolean                    @default(false)
  marks        Decimal?                   @db.Decimal(6, 2)
  feedback     String?
  status       AssignmentSubmissionStatus @default(SUBMITTED)
  gradedById   String?
  gradedBy     User?                      @relation(name: "GradedSubmissions", fields: [gradedById], references: [id])
  gradedAt     DateTime?
  createdAt    DateTime                   @default(now())
  updatedAt    DateTime                   @updatedAt
  attachments  Attachment[]

  @@unique([assignmentId, studentId])
  @@index([assignmentId, status])
  @@index([studentId])
}

model Attachment {
  id           String                @id @default(cuid())
  branchId     String
  branch       Branch                @relation(fields: [branchId], references: [id], onDelete: Cascade)
  lectureId    String?
  lecture      Lecture?              @relation(fields: [lectureId], references: [id], onDelete: Cascade)
  assignmentId String?
  assignment   Assignment?           @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  submissionId String?
  submission   AssignmentSubmission? @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  kind         AttachmentKind
  title        String
  url          String?
  publicId     String?
  resourceType String?
  format       String?
  bytes        Int?
  originalName String?
  uploadedById String
  uploadedBy   User                  @relation(name: "UploadedAttachments", fields: [uploadedById], references: [id])
  createdAt    DateTime              @default(now())

  @@index([branchId])
  @@index([lectureId])
  @@index([assignmentId])
  @@index([submissionId])
}

model Notification {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(name: "UserNotifications", fields: [userId], references: [id], onDelete: Cascade)
  type       String
  title      String
  body       String
  entityType String?
  entityId   String?
  readAt     DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId, readAt, createdAt])
}

model FeeCharge {
  id           String          @id @default(cuid())
  branchId     String
  branch       Branch          @relation(fields: [branchId], references: [id])
  studentId    String
  student      User            @relation("StudentFeeCharges", fields: [studentId], references: [id])
  batchId      String
  batch        Batch           @relation(fields: [batchId], references: [id])
  enrollmentId String?
  enrollment   Enrollment?     @relation(fields: [enrollmentId], references: [id], onDelete: SetNull)
  kind         FeeChargeKind
  period       String?
  description  String
  amount       Decimal         @db.Decimal(12, 2)
  dueDate      DateTime        @db.Date
  source       FeeChargeSource
  status       FeeChargeStatus @default(ACTIVE)
  voidReason   String?
  voidedAt     DateTime?
  voidedById   String?
  voidedBy     User?           @relation("FeeChargesVoided", fields: [voidedById], references: [id], onDelete: SetNull)
  createdById  String
  createdBy    User            @relation("FeeChargesCreated", fields: [createdById], references: [id])
  createdAt    DateTime        @default(now())

  adjustments  FeeAdjustment[]
  allocations  PaymentAllocation[]

  @@index([branchId])
  @@index([studentId])
  @@index([batchId])
  @@index([status])
  @@index([dueDate])
  @@index([period])
}

model FeeAdjustment {
  id          String              @id @default(cuid())
  branchId    String
  branch      Branch              @relation(fields: [branchId], references: [id])
  chargeId    String
  charge      FeeCharge           @relation(fields: [chargeId], references: [id])
  type        FeeAdjustmentType
  amount      Decimal             @db.Decimal(12, 2)
  reason      String              @db.VarChar(200)
  status      FeeAdjustmentStatus @default(ACTIVE)
  voidReason  String?
  voidedAt    DateTime?
  voidedById  String?
  voidedBy    User?               @relation("FeeAdjustmentsVoided", fields: [voidedById], references: [id], onDelete: SetNull)
  createdById String
  createdBy   User                @relation("FeeAdjustmentsCreated", fields: [createdById], references: [id])
  createdAt   DateTime            @default(now())

  @@index([branchId])
  @@index([chargeId])
  @@index([status])
}

model Payment {
  id             String              @id @default(cuid())
  branchId       String
  branch         Branch              @relation(fields: [branchId], references: [id])
  studentId      String
  student        User                @relation("StudentPayments", fields: [studentId], references: [id])
  receiptNumber  String              @unique
  receivedAt     DateTime
  amount         Decimal             @db.Decimal(12, 2)
  method         PaymentMethod
  reference      String?
  note           String?
  receivedById   String
  receivedBy     User                @relation("ReceivedPayments", fields: [receivedById], references: [id])
  idempotencyKey String?
  source         PaymentSource
  createdAt      DateTime            @default(now())

  allocations    PaymentAllocation[]
  reversal       PaymentReversal?

  @@index([branchId])
  @@index([studentId])
  @@index([receivedAt])
  @@index([receivedById])
}

model PaymentAllocation {
  id        String    @id @default(cuid())
  branchId  String
  branch    Branch    @relation(fields: [branchId], references: [id])
  paymentId String
  payment   Payment   @relation(fields: [paymentId], references: [id])
  chargeId  String
  charge    FeeCharge @relation(fields: [chargeId], references: [id])
  amount    Decimal   @db.Decimal(12, 2)
  createdAt DateTime  @default(now())

  @@unique([paymentId, chargeId])
  @@index([branchId])
  @@index([paymentId])
  @@index([chargeId])
}

model PaymentReversal {
  id           String   @id @default(cuid())
  branchId     String
  branch       Branch   @relation(fields: [branchId], references: [id])
  paymentId    String   @unique
  payment      Payment  @relation(fields: [paymentId], references: [id])
  reason       String
  reversedById String
  reversedBy   User     @relation("PaymentReversals", fields: [reversedById], references: [id])
  reversedAt   DateTime @default(now())

  @@index([branchId])
}

model ReceiptSequence {
  id         String @id @default(cuid())
  branchId   String
  branch     Branch @relation(fields: [branchId], references: [id])
  year       Int
  lastNumber Int    @default(0)

  @@unique([branchId, year])
}



