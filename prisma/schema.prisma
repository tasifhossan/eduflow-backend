// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  ADMIN
  TEACHER
  STUDENT
  GUARDIAN
}

enum BatchType {
  ACADEMIC
  ADMISSION
}

enum EnrollmentStatus {
  ACTIVE
  INACTIVE
}

enum DayOfWeek {
  SUNDAY
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
}

model Branch {
  id        String   @id @default(cuid())
  name      String
  address   String?
  createdAt DateTime @default(now())
  users     User[]
  batches   Batch[]
}

model User {
  id                String          @id @default(cuid())
  name              String
  email             String          @unique
  phone             String?
  guardianName      String?
  guardianPhone     String?
  password          String
  role              Role
  branchId          String
  branch            Branch          @relation(fields: [branchId], references: [id])
  createdAt         DateTime        @default(now())
  teachingBatches   Batch[]         @relation(name: "TeachingBatches")
  enrollments       Enrollment[]
  attendances       Attendance[]    @relation(name: "StudentAttendances")
  markedAttendances Attendance[]    @relation(name: "MarkedAttendances")
  createdTests      Test[]          @relation(name: "CreatedTests")
  studentAnswers    StudentAnswer[]
  results           Result[]
}

model Subject {
  id       String    @id @default(cuid())
  name     String
  chapters Chapter[]
  batches  Batch[]
}

model Chapter {
  id        String  @id @default(cuid())
  name      String
  subjectId String
  subject   Subject @relation(fields: [subjectId], references: [id])
  tests     Test[]
}

model Batch {
  id           String        @id @default(cuid())
  name         String
  type         BatchType
  classLevel   String?
  subjectId    String
  subject      Subject       @relation(fields: [subjectId], references: [id])
  branchId     String
  branch       Branch        @relation(fields: [branchId], references: [id])
  createdAt    DateTime      @default(now())
  teacherId    String?
  teacher      User?         @relation(name: "TeachingBatches", fields: [teacherId], references: [id])
  enrollments  Enrollment[]
  routineSlots RoutineSlot[]
  attendances  Attendance[]
  tests        Test[]
}

model Enrollment {
  id         String           @id @default(cuid())
  studentId  String
  student    User             @relation(fields: [studentId], references: [id])
  batchId    String
  batch      Batch            @relation(fields: [batchId], references: [id])
  enrolledAt DateTime         @default(now())
  status     EnrollmentStatus @default(ACTIVE)

  @@unique([studentId, batchId])
}

model RoutineSlot {
  id        String    @id @default(cuid())
  batchId   String
  batch     Batch     @relation(fields: [batchId], references: [id])
  dayOfWeek DayOfWeek
  startTime String
  endTime   String
}

model Attendance {
  id         String           @id @default(cuid())
  studentId  String
  student    User             @relation(name: "StudentAttendances", fields: [studentId], references: [id])
  batchId    String
  batch      Batch            @relation(fields: [batchId], references: [id])
  date       DateTime
  status     AttendanceStatus
  markedById String
  markedBy   User             @relation(name: "MarkedAttendances", fields: [markedById], references: [id])

  @@unique([studentId, batchId, date])
}

enum TestType {
  MCQ
  WRITTEN
  MIXED
  OFFLINE
}

enum QuestionType {
  MCQ
  WRITTEN
}

model Test {
  id                   String     @id @default(cuid())
  title                String
  type                 TestType
  batchId              String
  batch                Batch      @relation(fields: [batchId], references: [id])
  chapterId            String?
  chapter              Chapter?   @relation(fields: [chapterId], references: [id])
  totalMarks           Float
  negativeMarkingValue Float      @default(0)
  durationMinutes      Int?
  testDate             DateTime
  createdById          String
  createdBy            User       @relation(name: "CreatedTests", fields: [createdById], references: [id])
  createdAt            DateTime   @default(now())
  questions            Question[]
  results              Result[]
}

model Question {
  id             String          @id @default(cuid())
  testId         String
  test           Test            @relation(fields: [testId], references: [id], onDelete: Cascade)
  type           QuestionType
  text           String
  marks          Float
  order          Int
  options        Option[]
  studentAnswers StudentAnswer[]
}

model Option {
  id             String          @id @default(cuid())
  questionId     String
  question       Question        @relation(fields: [questionId], references: [id], onDelete: Cascade)
  text           String
  isCorrect      Boolean         @default(false)
  studentAnswers StudentAnswer[]
}

model StudentAnswer {
  id                String   @id @default(cuid())
  studentId         String
  student           User     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  questionId        String
  question          Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  selectedOptionId  String?
  selectedOption    Option?  @relation(fields: [selectedOptionId], references: [id])
  writtenAnswerText String?
  marksAwarded      Float?

  @@unique([studentId, questionId])
}

model Result {
  id                 String   @id @default(cuid())
  studentId          String
  student            User     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  testId             String
  test               Test     @relation(fields: [testId], references: [id], onDelete: Cascade)
  totalMarksObtained Float
  rank               Int?
  submittedAt        DateTime

  @@unique([studentId, testId])
}
